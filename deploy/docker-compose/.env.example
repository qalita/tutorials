# Copy to ".env" next to docker-compose.yaml, then fill in the token.
# Docker Compose reads this file automatically.

# Starts the worker alongside the platform. Without it, `docker compose up -d`
# brings up the platform only - which is what you want on the very first run,
# before a token exists.
COMPOSE_PROFILES=worker

# User-scoped API token created from the platform UI, by a user holding at
# least the Data Engineer role. The worker cannot register without it.
QALITA_WORKER_TOKEN=

# Name the worker registers under on the platform.
QALITA_WORKER_NAME=worker-1

# Host port for the backend's gRPC endpoint. Only the published port changes;
# the server always binds 50051 inside the container, and the worker reaches it
# over the compose network without going through the host.
# QALITA_GRPC_PORT=50051
